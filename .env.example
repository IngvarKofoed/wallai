# wallai environment — copy this file to `.env` and fill in your values.
#   cp .env.example .env
# `.env` is gitignored; never commit a real key.

# Required for a live run: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model the loop uses (default: claude-sonnet-5).
# WALLAI_MODEL=claude-opus-4-8

# Optional: WebSocket server port (default: 8787). If you change it, set VITE_WS_PORT to the
# same value so the browser connects to the right port.
# WALLAI_PORT=8787
# VITE_WS_PORT=8787
